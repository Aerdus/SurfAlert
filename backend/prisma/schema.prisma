generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Station {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  stationType String   @default("TIDE")  // "TIDE" | "WAVE" | "WIND"
  apiUrl      String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  tideReadings    TideReading[]

  @@index([stationType])
  @@index([latitude, longitude])
}

model TideReading {
  id          Int       @id @default(autoincrement())
  stationId   Int
  timestamp   DateTime
  tide        Float
  station     Station   @relation(fields: [stationId], references: [id])

  @@unique([stationId, timestamp])
  @@index([timestamp])
}